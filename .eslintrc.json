{
  "extends": [
    "next/core-web-vitals",
    "eslint:recommended"
  ],
  "rules": {
    "no-unused-vars": "warn",
    "no-console": ["warn", { "allow": ["warn", "error"] }],
    "prefer-const": "error",
    "no-duplicate-imports": "error",
    "@next/next/no-img-element": "warn"
  },
  "env": {
    "browser": true,
    "node": true,
    "es6": true
  }
}
